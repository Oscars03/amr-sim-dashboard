<?xml version="1.0"?>
<!--
  Rhino — Ackermann AMR — amr_2dsim / amr-sim-dashboard variant
  SYNCED 2026-08-21 to rhino-robot-ws@e9f770e  src/rhino/urdf/rhino.urdf

  RELATIONSHIP TO THE AUTHORITATIVE URDF
    rhino-robot-ws/src/rhino/urdf/rhino.urdf is the twin of record: full wheel and
    steer kinematic chain, collision, placeholder inertials. Use THAT one for RViz,
    robot_state_publisher, Gazebo, or anything that needs the joint tree.
    THIS file is the amr_2dsim variant. amr_2dsim is a 2-D kinematic simulator: it
    reads <amr_sim_config> plus the base_link box plus the laser joint, and draws
    the wheels itself from <wheel_base>/<axle_track>. Shipping the four real wheel
    links here would make the dashboard render eight wheels (its own four, plus
    ours), so they are deliberately omitted. Every shared number below is
    byte-identical to the authoritative file — if that file changes, change this one.

  GEOMETRY IS IDENTICAL TO THE AUTHORITATIVE FILE
    base_link at GROUND LEVEL, directly below the centre of the rear axle
      [decided 2026-08-14; no base_footprint — the two frames are collapsed]
    body box 0.600 x 0.440, centre at x = +0.205, spanning z = [0.050, 0.250]
    laser optical centre at xyz = 0.31 0 0.510, yaw 180 deg  [measured 2026-08-14]
      — matches the live static_transform_publisher in lidar_bringup.launch.py:19
        (tf_z = '0.510'; the old 0.295 was wrong by 215 mm and is retracted)

  amr_sim_config VALUES   (re-synced 2026-09-24 to master-ackerman-thesis CLAUDE_rhino.md §3/§16/§19)
    [measured]   wheel_base 0.385 · axle_track 0.345 · wheel_radius 0.0889
    [measured]   max_steering_angle 18.95 deg — delta_BIKE, not a wheel angle, not
                 servo_max_steer_deg (20.0f, the SERVO COMMAND range). 9-point
                 protractor calibration 2026-09-07: delta_bike reaches 18.95 deg
                 turning LEFT and 21.83 deg turning RIGHT. This field feeds the
                 clamp on the ACHIEVED bicycle angle (delta in simulator_node.py's
                 w = v*tan(delta)/L), and the sim models one symmetric limit, so it
                 takes the worst (left) case — the same one Nav2's planner assumes:
                 R_min = 0.385 / tan(18.95 deg) = 1.121 m, padded to
                 minimum_turning_radius 1.20. Using the 21.83 right-turn value
                 would let the sim out-corner what the planner treats as safe.
                 RETRACTED here 2026-09-24: "18 deg (L) / 25 deg (R)" and
                 "R_min = 0.385/tan(18) = 1.185 m" — that 18/25 pair was the RIGHT
                 wheel read in two turn directions (CLAUDE_rhino.md §2/§24).
    [measured]   max_steering_rate 82.0 deg/s and max_steering_accel 262.2 deg/s^2 —
                 the servo at servo_speed 3000 (fixed for Phase B, §21), 64 slews,
                 2026-09-08 [CI 80.8–83.3 / 260.0–264.5]. The servo is
                 ACCELERATION-limited: a 5 deg correction peaks at ~36 deg/s, only
                 steps >= ~26 deg reach 82 (actuators.slew_steering reproduces both).
                 Measured at the servo AXLE: delta_bike moves 1.091x that when
                 turning right and 0.964x turning left (binding wheel-side peak
                 89.5 deg/s). The sim applies the axle values symmetrically — a
                 +/-9 % asymmetry it does not model.
    [LOCK §19]   creep_on_turn_mps 0.0 — 0.3 drove the robot forward on any rotation
                 command (§11.2a) and was the shipped default until 2026-09-19.
                 no_creep_mode stays false: that flag also selects the Nav2
                 (signed-vx) steering convention when reversing.
    [open]       max_linear_accel NOT set (instant). The MCU smoother's running value
                 is unresolved: PRSH 2026-08-13 reads kin_max_lin_acc 5.0 m/s^2,
                 paper_data/revsign_floor_2026-09-09.md quotes 0.2 from the source.
                 Filling it with a guess is what §16 forbids; velocity_smoother
                 (§21 factors 7/8) still bounds the command upstream in the sim.
                 ticks_per_meter from PPR = 800 (PRSH dump 2026-08-13)
                 laser_range_max 30.0 m (RPLIDAR S2E)
    [derived]    robot_radius 0.551 = sqrt(0.505^2 + 0.220^2), circumscribed from base_link
                 ticks_per_meter 1432.2 = 800 / (2*pi*0.0889)
    [PLACEHOLDER] wheel_width 0.050 — never measured; drawing only, no physics effect
    ⚠ Still §24: simulated jerk is not a result. These limits make the sim's steering
      lag realistic for rehearsal (planner feasibility, clearance, tracking), nothing more.

  NO <inertial> HERE, BY DESIGN. M and CoM are NOT MEASURED. amr_2dsim is purely
  kinematic and ignores inertia; the placeholders live in the authoritative file only.

  UPSTREAM NOTES
    1. FIXED 2026-08-21: parse_base_link_box() used to read <box size> but not
       <origin>, centring the collision rectangle on base_link — 0.205 m rearward of
       Rhino's real body. It now honours the origin, so the +0.205 offset below is
       the actual collision footprint. Requires that patched simulator_node.py.
    2. The dashboard draws wheels at +/- wheel_base/2, assuming base_link is at the
       wheelbase midpoint; Rhino's is at the rear axle, so they sit 0.1925 m back.
       Cosmetic only — it does not touch the kinematics.
-->
<robot name="rhino">

  <!-- AMR Simulation Config -->
  <amr_sim_config>
    <kinematic_model>ackermann</kinematic_model>
    <geometry_type>rectangle</geometry_type>
    <wheel_base>0.385</wheel_base>
    <axle_track>0.345</axle_track>
    <robot_radius>0.551</robot_radius>
    <wheel_radius>0.0889</wheel_radius>
    <wheel_width>0.0500</wheel_width>
    <laser_range_max>30.0</laser_range_max>
    <laser_x>0.310</laser_x>
    <laser_y>0.000</laser_y>
    <laser_height>0.03885</laser_height>
    <ticks_per_meter>1432.2</ticks_per_meter>
    <!-- DEGREES (simulator_node.py converts). delta_bike worst case (left), NOT the
         servo's 20 deg command range — see amr_sim_config VALUES above. 18.95 deg
         gives R_min 1.121 m under Nav2's minimum_turning_radius: 1.20. -->
    <max_steering_angle>18.95</max_steering_angle>
    <!-- Servo dynamics at servo_speed 3000 [measured 2026-09-08], DEGREES/s and /s^2. -->
    <max_steering_rate>82.0</max_steering_rate>
    <max_steering_accel>262.2</max_steering_accel>
    <drive_axle_x>0.0</drive_axle_x>
    <!-- §19 LOCK: 0.0. 0.3 injected uncommanded forward motion on every rotation command. -->
    <creep_on_turn_mps>0.0</creep_on_turn_mps>
    <presteer_ms>200</presteer_ms>
    <no_creep_mode>false</no_creep_mode>
  </amr_sim_config>

  <material name="chassis_grey">
    <color rgba="0.55 0.55 0.58 1.0"/>
  </material>
  <material name="lidar_red">
    <color rgba="0.70 0.05 0.05 1.0"/>
  </material>

  <!-- Body: spans x = -0.095 (rear overhang) .. +0.505 (front overhang) from the
       rear axle, z = [0.050, 0.250] on top of the measured 0.050 ground clearance. -->
  <link name="base_link">
    <visual>
      <origin xyz="0.205 0 0.150" rpy="0 0 0"/>
      <geometry>
        <box size="0.600 0.440 0.20"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>

  <!-- LiDAR — RPLIDAR S2E, facing BACKWARDS (the 180 deg yaw is real).
       The frame origin is the OPTICAL CENTRE, so the body sits -0.0145 off-centre
       within it: top 0.515 [measured] - 0.03885/2 [datasheet] - 0.510 = -0.0145.
       amr_2dsim reads only xyz from this joint and ignores rpy, so the simulated
       scan is not yaw-flipped; on the real robot TF handles that. -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 -0.0145" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0385" length="0.03885"/></geometry>
      <material name="lidar_red"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.31 0 0.510" rpy="0 0 3.14159"/>
  </joint>

</robot>
